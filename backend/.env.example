# Server Configuration
PORT=5000
NODE_ENV=production

# TiDB Cloud Starter / Serverless MySQL Database Configuration
# In TiDB Cloud Console -> Clusters -> Connect -> General
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_cluster_prefix.root
DB_PASSWORD=your_database_password
DB_NAME=shopera

# MySQL / TiDB Cloud TLS Configuration
# TiDB Cloud requires TLS 1.2+ with valid certificates
DB_SSL=true

# Optional: Connection Pool Limit (default: 10)
DB_CONNECTION_LIMIT=10

# Alternative: Single Connection URI (optional)
# DATABASE_URL=mysql://user:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/shopera?ssl={"minVersion":"TLSv1.2","rejectUnauthorized":true}

# JWT Authentication (generate a secure random string in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Client URL for CORS (comma-separated if multiple domains, e.g. frontend on Render/Vercel)
CLIENT_URL=https://your-frontend.onrender.com,http://localhost:3000
